<?xml version="1.0"?>
<package format="3">
  <name>tiago_dual_bringup</name>
  <version>2.12.1</version>
  <description>Launch files to upload the TIAGo Dual robot description and start the controllers</description>
  <maintainer email="jordan.palacios@pal-robotics.com">Jordan Palacios</maintainer>
  <author email="david.terkuile@pal-robotics.com">David ter Kuile</author>
  <maintainer email="david.terkuile@pal-robotics.com">David ter Kuile</maintainer>
  <license>Apache License 2.0</license>

  <url type="website">https://github.com/pal-robotics/tiago_dual_simulation</url>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <build_depend condition="$PAL_DISTRO >= alum">pal_module_cmake</build_depend>

  <exec_depend>tiago_dual_controller_configuration</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>joy_linux</exec_depend>
  <exec_depend>joy_teleop</exec_depend>
  <exec_depend>launch_pal</exec_depend>
  <exec_depend>play_motion2</exec_depend>
  <exec_depend>teleop_tools_msgs</exec_depend>
  <exec_depend>tiago_dual_description</exec_depend>
  <exec_depend>twist_mux</exec_depend>
  <exec_depend>twist_mux_msgs</exec_depend>
  <exec_depend condition="$PAL_DISTRO > 0">collision_aware_joint_trajectory_wrapper</exec_depend>
    
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
